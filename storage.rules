rules_version = '2';

// Même politique que firestore.rules : réservé aux comptes connectés.
// Delete est une règle à part de write — auparavant `write` seul couvrait
// aussi delete mais testait `request.resource.size`, qui est toujours null
// sur un delete, donc la condition échouait et les suppressions étaient
// refusées en silence (photos orphelines qui restaient dans le bucket).
service firebase.storage {
  match /b/{bucket}/o {
    match /recipes/{recipeId}/{fileName} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null;
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
